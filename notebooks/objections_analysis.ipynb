# Preprocessing: sentence splitting and simple speaker heuristics
import itertools

sentence_split_regex = re.compile(r"(?<=[\.!\?])\s+")

AGENT_CUES = [
    "my name is", "this is", "thank you for holding", "i will connect", "connecting your call",
    "benefits", "no additional cost", "you will receive", "press [phone_number]", "recorded line",
    "[occupation]", "[organization]", "[money_amount]", "co payment", "co payments"
]
CUSTOMER_CUES = [
    "not interested", "don't have time", "no time", "call me back", "who are you", "what is this",
    "i already have", "i don't", "i can't", "no ", "not now", "busy", "have to leave", "i'm in a rush",
    "i think", "i guess", "i'm not sure", "i didn't understand"
]

def split_sentences(text: str) -> List[str]:
    text = str(text).replace("\n", " ")
    parts = sentence_split_regex.split(text)
    return [s.strip() for s in parts if s and len(s.strip()) > 1]


def score_contains_any(text: str, cues: List[str]) -> int:
    lower = text.lower()
    return sum(1 for c in cues if c in lower)


def tag_speaker(sent: str) -> str:
    agent_score = score_contains_any(sent, AGENT_CUES)
    customer_score = score_contains_any(sent, CUSTOMER_CUES)
    if agent_score == 0 and customer_score == 0:
        # weak fallback: agent if contains 'we/our' and benefits jargon
        if any(k in sent.lower() for k in ["medicare", "benefit", "transfer", "zip code", "verify", "date of birth"]):
            return "agent"
        return "unknown"
    return "agent" if agent_score >= customer_score else "customer"


df["sentences"] = df["full_text"].apply(split_sentences)
df["speaker_tags"] = df["sentences"].apply(lambda sents: [tag_speaker(s) for s in sents])

