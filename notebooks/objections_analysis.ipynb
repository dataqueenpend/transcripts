# Wzorce reakcji doradcy (zbijanie)
BENEFIT_PATTERNS = [r"\bdodatkow[eey] korzy[śs]ci\b", r"\bbez dodatkowych koszt[oó]w\b", r"\bzaoszcz[eę]dzisz\b", r"\bwarto[śs][ćc]\b"]
REPHRASE_COST = [r"\broz[kc]ład\b.*\bp[łl]atno[śs][ćc]\b", r"\bni[sś]ka\b.*\bsk[łl]adka\b", r"\bbrak dop[łl]at\b"]
