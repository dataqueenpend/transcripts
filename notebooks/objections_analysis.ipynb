COND_CLOSE = [r"\bje[śs]li to dla Pana/Pani ok\b", r"\bmo[żz]emy przej[śs][ćc] dalej\b"]

REBUTTAL_CATS = {
    "benefit": BENEFIT_PATTERNS,
    "rephrase_cost": REPHRASE_COST,
    "alternative": ALTERNATIVE,
    "clarify": CLARIFY,
    "social_proof": SOCIAL_PROOF,
    "conditional_close": COND_CLOSE,
}

OBJECTION_CATS = {
    "price": PRICE_OBJS,
    "timing": TIMING_OBJS,
    "need": NEED_OBJS,
    "trust": TRUST_OBJS,
    "generic_negation": NEGATIONS,
}

def match_any(text: str, patterns: List[str]) -> bool:
    text_low = text.lower()
    return any(re.search(p, text_low) for p in patterns)

def detect_objection_category(text: str) -> str | None:
    for cat, pats in OBJECTION_CATS.items():
        if match_any(text, pats):
            return cat
    return None

def detect_rebuttal_category(text: str) -> str | None:
    for cat, pats in REBUTTAL_CATS.items():
        if match_any(text, pats):
            return cat
    return None
import nltk
nltk.download('punkt')
from nltk.tokenize import sent_tokenize

# Prosty tokenizator na wypadek braku punktu

def split_sentences(text: str) -> list:
    try:
        return [s.strip() for s in sent_tokenize(text) if s.strip()]
    except Exception:
        # fallback regex
        return [s.strip() for s in re.split(r"(?<=[.!?])\s+", text) if s.strip()]
