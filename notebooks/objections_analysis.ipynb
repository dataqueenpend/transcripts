records = []

for i, row in df.iterrows():
    text = str(row["full_text"])[:100000]
    if not is_sales_call(text):
        continue
    sentences = split_sentences(text)
    # Idź po zdaniach; gdy obiekcja klienta -> poszukaj odpowiedzi agenta w kolejnych N zdaniach
    for idx, sent in enumerate(sentences):
        role = infer_role(sent)
        if role == ROLE_CUSTOMER:
            obj_cat = detect_objection_category(sent)
            if obj_cat:
                # znajdź odpowiedź agenta w kolejnych 3 zdaniach
                rebuttal_sent, rebuttal_cat = None, None
                for j in range(idx + 1, min(idx + 4, len(sentences))):
                    role_j = infer_role(sentences[j])
                    if role_j == ROLE_AGENT:
                        rebuttal_sent = sentences[j]
                        rebuttal_cat = detect_rebuttal_category(rebuttal_sent)
                        break
                records.append({
                    "filename": row.get("filename", ""),
                    "objection_sentence": sent,
                    "objection_category": obj_cat,
                    "rebuttal_sentence": rebuttal_sent,
                    "rebuttal_category": rebuttal_cat,
                })

