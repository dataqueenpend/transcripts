# Heurystyka ról — prosta: na podstawie słów kluczowych
AGENT_CUES = [r"\bnazywam si[eę]\b", r"\bdzwoni[eę]\b", r"\boferta\b", r"\bproponuj[eę]\b", r"\bmamy dla Pana|Pani\b"]
CUSTOMER_CUES = [r"\bnie\b", r"\bnie chc[eę]\b", r"\bnie potrzebuj[eę]\b", r"\bdrogo\b", r"\bnie mam czasu\b"]

ROLE_AGENT = "agent"
ROLE_CUSTOMER = "customer"


def infer_role(sentence: str) -> str:
    s = sentence.lower()
    if any(re.search(p, s) for p in AGENT_CUES):
        return ROLE_AGENT
    if any(re.search(p, s) for p in CUSTOMER_CUES):
        return ROLE_CUSTOMER
    # fallback: dłuższe zdania częściej agent
    return ROLE_AGENT if len(s) > 80 else ROLE_CUSTOMER


def is_sales_call(text: str) -> bool:
    sales_markers = [r"\boferta\b", r"\bkorzy[śs]ci\b", r"\bpromocj[aey]\b", r"\bubezpieczeni[ea]\b", r"\bplan\b", r"\bsprzeda[żz]\b"]
    return any(re.search(p, text.lower()) for p in sales_markers)
# Słowa kluczowe i wzorce
